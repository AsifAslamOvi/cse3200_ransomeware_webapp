## Example env file for mitigation notifications
# Generic webhook (POST JSON) - optional
MITIGATION_WEBHOOK_URL=https://example.com/webhook

# Slack incoming webhook - optional
SLACK_WEBHOOK_URL=

# Email notifications (comma separated recipients)
# Set to the recipient address to receive mitigation notices
MITIGATION_EMAIL_TO=asifaslamovi@gmail.com

# SMTP settings for sending email notifications
# For Gmail SMTP use smtp.gmail.com with port 587 (STARTTLS) or 465 (SSL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=asifaslamovi@gmail.com

# Notes: copy this file to .env and fill any secret values, or set real environment variables.